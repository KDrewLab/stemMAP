
executor {
    name = 'local'
    cpus = 6
}

singularity.autoMounts = true
//singularity.runOptions = "--home /tmp"


params {
    fasta_file = './uniprot_fasta_proteome_mm_20230515.fasta'
    contam_file = './contam.fasta'
    mzxml_files = './mzXML//*.mzXML'
    elut_file = 'PXD014607_MES_SEC_control.elut'
    cluster_file = 'PXD014607_MES_SEC_control.xlsx'
    annotations_file = './uniprot-reviewed_mm_20230516.tab'
}


