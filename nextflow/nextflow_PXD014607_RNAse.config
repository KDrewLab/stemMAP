
executor {
    name = 'local'
    cpus = 6
}

singularity.autoMounts = true
//singularity.runOptions = "--home /tmp"


params {
    fasta_file = './uniprot_fasta_mm_20230515.fasta'
    contam_file = './contam.fasta'
    mzxml_files = './mzXML//*.mzXML'
    elut_file = 'PXD014607_MES_SEC_RNAse.elut'
    cluster_file = 'PXD014607_MES_SEC_RNAse.xlsx'
    annotations_file = './DB_mouse/uniprot-reviewed_20230516.tab'
}


